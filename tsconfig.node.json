{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "capacitor.config.ts",
    "scripts",
    "e2e",
    "test",
    "src/**/__tests__/*.ts",
    "src/env.d.ts"
  ]
}